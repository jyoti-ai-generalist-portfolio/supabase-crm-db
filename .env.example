SUPABASE_ACCESS_TOKEN = {Enter your access token here}
SUPABASE_PROJECT_ID = {Enter your project id here}
SUPABASE_DB_PASSWORD = {Enter your supabase db password here}
# Copy this file to .env.local and fill in your real Supabase project values.
# .env.local is git-ignored — never commit real credentials.

# Found in Supabase dashboard: Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key (server-side only — has elevated privileges, keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Notification recipients (Section 2 workflow emails) ---
# UC-001 Task 6: new-lead notifications go to SalesRepEmail.
# UC-002 Task 13: deal-closed notifications go to SalesMgrEmail + CEOEmail.
SalesRepEmail=salesrep@example.com
SalesMgrEmail=salesmgr@example.com
CEOEmail=ceo@example.com

# --- SMTP settings for outgoing email (nodemailer) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_username_or_email@example.com
SMTP_PASS=your_secret_smtp_password

# Email Settings
EMAIL_FROM="Your App Name <your_username_or_email@example.com>"